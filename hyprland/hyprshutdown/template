# Template file for 'hyprshutdown'
pkgname=hyprshutdown
version=0.1.1
revision=2
build_style=cmake
hostmakedepends="pkgconf"
makedepends="hyprtoolkit hyprutils cairo-devel glaze libdrm-devel
	libxkbcommon-devel pango-devel pixman-devel"
short_desc="Graceful shutdown/logout utility for Hyprland"
maintainer="Nizarjh <chel773@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprshutdown"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=32adb385b7bfe22398d45cd5325416bf0ac3ae4a5bd89678353dae96f92ba638
repository=hypr-d77

# upstream's pkg_check_modules(... IMPORTED_TARGET ...) doesn't propagate
# pixman-1's/libdrm's non-standard include subdirs to the actual targets,
# even though hyprutils/aquamarine's public headers need <pixman.h> and
# <drm_fourcc.h>; add them explicitly.
pre_configure() {
	CFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
	CXXFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
}

post_install() {
	vlicense LICENSE
}
