# Template file for 'hyprgraphics'
pkgname=hyprgraphics
version=0.6.0
revision=1
build_style=cmake
configure_args="--no-warn-unused-cli"
hostmakedepends="cmake pkgconf"
makedepends="cairo-devel pango-devel file-devel hyprutils
 libjpeg-turbo-devel libjxl-devel libspng librsvg-devel
 libwebp-devel pixman-devel libglvnd-devel libdrm-devel"
short_desc="Hyprland graphics resources and utilities"
maintainer="Nizarjh <chel773@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprgraphics"
distfiles="https://github.com/hyprwm/hyprgraphics/archive/refs/tags/v${version}.tar.gz"
checksum=27e9e19ff59ba75a2963d72c3dcb5c0840b266b90d7fca6d5df7cac105419b08
repository=hypr-d77
make_check=no # cant run in sandbox

post_install() {
	vlicense LICENSE
	# 0.6.0 lists its image codecs (libjpeg, libwebp, librsvg, libmagic,
	# libjxl) in Requires.private; pkg-config then demands all their -devel
	# packages from every consumer, though they only matter for static links
	vsed -i '/^Requires.private:/d' ${DESTDIR}/usr/lib/pkgconfig/hyprgraphics.pc
}
