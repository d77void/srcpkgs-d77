# Template file for 'hyprpaper'
pkgname=hyprpaper
version=0.8.4
revision=2
build_style=cmake
hostmakedepends="pkgconf hyprwayland-scanner hyprwire hyprland-protocols wayland-protocols"
makedepends="cairo-devel file-devel libjpeg-turbo-devel libwebp-devel
 hyprgraphics hyprutils hyprlang hyprtoolkit hyprwire pango-devel wlroots-devel"
short_desc="Fast wallpaper utility for wlroots compositors with IPC controls"
maintainer="Nizarjh <chel773@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprpaper"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=4912c7aede303918f38a3fc6b294429e2d541b639ebba67bcab58d1d367ea360
repository=hypr-d77

# upstream's pkg_check_modules(... IMPORTED_TARGET ...) doesn't propagate
# pixman-1's/libdrm's non-standard include subdirs to the actual targets,
# even though hyprutils/aquamarine's public headers need <pixman.h> and
# <drm_fourcc.h>; add them explicitly.
pre_configure() {
	CFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
	CXXFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
}

post_install() {
	vlicense LICENSE
}
