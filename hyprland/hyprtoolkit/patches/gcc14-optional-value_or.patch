GCC 14's std::optional::value_or() has no default template argument (P2218,
GCC 15), so a braced initializer can't be deduced: spell out the type.

diff -ru a/src/element/columnLayout/ColumnLayout.cpp b/src/element/columnLayout/ColumnLayout.cpp
--- a/src/element/columnLayout/ColumnLayout.cpp	2026-11-25 17:38:18.005977342 +0000
+++ b/src/element/columnLayout/ColumnLayout.cpp	2026-11-25 17:38:18.010647562 +0000
@@ -77,7 +77,7 @@
     Vector2D max;
     for (const auto& child : impl->children) {
         // We never want percent children to drive the preferred size of their parent.
-        Vector2D childPref = child->preferredSize(parentForChild, false).value_or({ 0, 0 });
+        Vector2D childPref = child->preferredSize(parentForChild, false).value_or(Vector2D{0, 0});
 
         max.x = std::max(max.x, childPref.x);
         max.y += childPref.y + m_impl->data.gap;
diff -ru a/src/element/rowLayout/RowLayout.cpp b/src/element/rowLayout/RowLayout.cpp
--- a/src/element/rowLayout/RowLayout.cpp	2026-11-25 17:38:18.024052139 +0000
+++ b/src/element/rowLayout/RowLayout.cpp	2026-11-25 17:38:18.028647528 +0000
@@ -76,7 +76,7 @@
     Vector2D max;
     for (const auto& child : impl->children) {
         // We never want percent children to drive the preferred size of their parent.
-        Vector2D childPref = child->preferredSize(parentForChild, false).value_or({ 0, 0 });
+        Vector2D childPref = child->preferredSize(parentForChild, false).value_or(Vector2D{0, 0});
         max.x += childPref.x + m_impl->data.gap;
         max.y = std::max(max.y, childPref.y);
     }
