# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.7.0
revision=1
build_style=cmake
configure_args="-DDISABLE_TESTS=ON"
hostmakedepends="hyprwayland-scanner pkgconf"
makedepends="abseil-cpp-devel aquamarine cairo-devel gtest-devel hyprgraphics hyprlang hyprutils
 iniparser-devel libdrm-devel libgbm-devel libglvnd-devel libxkbcommon-devel
 pango-devel pixman-devel wayland-devel wayland-protocols"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="Nizarjh <chel773@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprgraphics"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=7dc82a531537fd068f51110fa49c4cab01f3419d9e2cb8c2c2f2e8c49e26bcde
repository=hypr-d77
make_check=no # cant run in sandbox

post_install() {
	vlicense LICENSE
	# Requires.private lists every internal dependency (iniparser, abseil,
	# wayland-protocols, ...); pkg-config then demands all their -devel
	# packages from every consumer, though they only matter for static links
	vsed -i '/^Requires.private:/d' ${DESTDIR}/usr/lib/pkgconfig/hyprtoolkit.pc
}
