# Template file for 'hyprpolkitagent'
pkgname=hyprpolkitagent
version=0.2.0
revision=1
build_style=cmake
hostmakedepends="pkgconf qt6-base qt6-declarative-devel"
makedepends="hyprutils hyprtoolkit hyprgraphics hyprlang sdbus-cpp elogind-devel polkit-qt6-devel qt6-base-devel qt6-declarative-devel"
depends="hyprland-qt-support"
