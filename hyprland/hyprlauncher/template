# Template file for 'hyprlauncher'
pkgname=hyprlauncher
version=0.1.7
revision=1
build_style=cmake
hostmakedepends="hyprwire pkgconf"
makedepends="hyprutils hyprwire hyprlang hyprtoolkit wayland-devel pixman-devel libdrm-devel
 icu-devel fontconfig-devel libqalculate-devel cairo-devel libxkbcommon-devel pango-devel
 wayland-protocols libglvnd-devel libgbm-devel iniparser-devel abseil-cpp-devel"
depends="wl-clipboard"
short_desc="Multipurpose and versatile launcher / picker for Hyprland"
maintainer="Nizarjh <chel773@tutamail.com>"
