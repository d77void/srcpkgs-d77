homepage="https://github.com/hyprwm/hyprlauncher"
distfiles="https://github.com/hyprwm/${pkgname}/archive/refs/tags/v${version}.tar.gz"
checksum=66a8b893c13fbf6c523bdf2974ef65101a0ca94f25e020f4f53f043470418340
repository=hypr-d77

# upstream's pkg_check_modules(... IMPORTED_TARGET ...) doesn't propagate
# pixman-1's/libdrm's non-standard include subdirs to the actual targets,
# even though hyprutils/aquamarine's public headers need <pixman.h> and
# <drm_fourcc.h>; add them explicitly.
pre_configure() {
	CFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
	CXXFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
}

post_install() {
	vlicense LICENSE
}
