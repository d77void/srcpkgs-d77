# Template file for 'hyprsysteminfo'
pkgname=hyprsysteminfo
version=0.2.0
revision=4
build_style=cmake
hostmakedepends="pkgconf xxd"
makedepends="hyprtoolkit hyprutils glaze cairo-devel libdrm-devel pciutils-devel pixman-devel"
short_desc="Tiny application to display information about the running system"
maintainer="Nizarjh <chel773@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprsysteminfo"
distfiles="https://github.com/hyprwm/hyprsysteminfo/archive/refs/tags/v${version}.tar.gz"
checksum=4f875e7e986deeda35c05090b59f11f3b5802cac8863dafcc6e8251ea37530b1
repository=hypr-d77

pre_configure() {
	xxd -i -n HYPRLAND_LOGO_BYTES resource/hyprlandlogo.svg > src/icons/hyprlandlogo.hpp
	# upstream's pkg_check_modules(... IMPORTED_TARGET ...) doesn't
	# propagate pixman-1's/libdrm's non-standard include subdirs to the
	# actual targets, even though hyprutils/aquamarine's public headers
	# need <pixman.h> and <drm_fourcc.h>; add them explicitly.
	CFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
	CXXFLAGS+=" -I${XBPS_CROSS_BASE}/usr/include/pixman-1 -I${XBPS_CROSS_BASE}/usr/include/libdrm"
}
post_install() {
	vlicense LICENSE
}
