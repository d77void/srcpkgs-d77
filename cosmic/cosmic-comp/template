# Upstream replaced the Makefile with a justfile in 1.10.0. `just install`
# ships the binary plus the default keybindings and tiling exceptions; the
# systemd units only come with install-bare-session, which isn't used. The
# wayland-sessions/cosmic.desktop entry is provided by cosmic-session.
do_install() {
	just rootdir="${DESTDIR}" cargo-target-dir="target/${RUST_TARGET}" install
}
