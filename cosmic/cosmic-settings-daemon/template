# Upstream replaced the Makefile with a justfile in 1.10.0; `just install`
# ships the binary, system_actions and the polkit rule.
do_install() {
	just rootdir="${DESTDIR}" cargo-target-dir="target/${RUST_TARGET}" install
	vinstall ${FILESDIR}/custom 644 usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1
}
