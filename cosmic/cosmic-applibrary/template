# Template file for 'cosmic-applibrary'
pkgname=cosmic-applibrary
version=1.11.0
revision=1
archs="x86_64* i686"
build_style="cargo"
configure_args="--all"
hostmakedepends="pkg-config $(vopt_if sccache "rust-sccache")"
makedepends="libxkbcommon-devel "
depends="libxkbcommon"
short_desc="Cosmic App Library"
maintainer="Bella109 <belladev109@proton.me>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-app-library"
distfiles="https://github.com/pop-os/cosmic-app-library/archive/refs/tags/epoch-${version}.tar.gz"
checksum=9ce3f012af1f885b0a99c589e77803c8d7fb76cba7a7202030cae19f1ac2dd55
repository=cosmic-d77
build_options="sccache"

pre_build() {
	$(vopt_if sccache "export RUSTC_WRAPPER=/usr/bin/sccache")
}

do_install() {
	# `just install` expects target/xdgen/*.desktop|*.metainfo.xml, which
	# only exist after running `just xdgen` (a separate, unvendored cargo
	# crate). Install the static equivalents already shipped in data/
	# instead, so the build stays offline-safe.
	vbin "target/${RUST_TARGET}/release/cosmic-app-library"
	vinstall data/com.system76.CosmicAppLibrary.desktop 644 usr/share/applications
	vinstall data/com.system76.CosmicAppLibrary.metainfo.xml 644 usr/share/appdata
	vinstall data/icons/com.system76.CosmicAppLibrary.svg 644 usr/share/icons/hicolor/scalable/apps
}
