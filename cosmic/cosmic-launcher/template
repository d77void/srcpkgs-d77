# Template file for 'cosmic-launcher'
pkgname=cosmic-launcher
version=1.9.0
revision=1
archs="x86_64* i686"
build_style="cargo"
configure_args="--all"
hostmakedepends="pkg-config $(vopt_if sccache "rust-sccache")"
makedepends="libxkbcommon-devel which"
depends="libxkbcommon pop-launcher"
short_desc="COSMIC App Launcher"
maintainer="Bella109 <belladev109@proton.me>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-launcher"
distfiles="https://github.com/pop-os/cosmic-launcher/archive/refs/tags/epoch-${version}.tar.gz"
checksum=9ded0bbe14a08f4b83da8124d1243c965cf71751dc7d94539dd71ad5a4eff54a
repository=cosmic-d77
build_options="sccache"

pre_build() {
	$(vopt_if sccache "export RUSTC_WRAPPER=/usr/bin/sccache")
}

do_install() {
	# `just install` expects target/xdgen/*.desktop|*.metainfo.xml, which
	# only exist after running `just xdgen` (a separate, unvendored cargo
	# crate). Install the static equivalents already shipped in data/
	# instead, so the build stays offline-safe.
	vbin "target/${RUST_TARGET}/release/cosmic-launcher"
	vinstall data/com.system76.CosmicLauncher.desktop 644 usr/share/applications
	vinstall data/com.system76.CosmicLauncher.metainfo.xml 644 usr/share/appdata
	vinstall data/icons/com.system76.CosmicLauncher.svg 644 usr/share/icons/hicolor/scalable/apps
}
