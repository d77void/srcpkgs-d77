# Template file for 'helium-d77'
pkgname=helium-d77
version=0.1.12
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="wayland-devel libxkbcommon-devel fontconfig-devel freetype-devel pam-devel"
# xbps has no optional dependencies, and unversioned ones never hold back
# upgrades. helium-osd calls amixer, brightnessctl and powerprofilesctl;
# amorphis (from the d77 repo) is what the session menu locks with.
depends="pam-libs wl-clipboard alsa-utils brightnessctl power-profiles-daemon
 amorphis"
short_desc="Wayland shell built with the Helium shell framework"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://github.com/dani-77/helium-d77"
distfiles="https://github.com/dani-77/helium-d77/archive/refs/tags/${version}.tar.gz"
checksum=ae5ba042f992c5e9c6d15f5ddd5adeab6595c05877636794dff0ada105a5a9a3
repository=d77

# build_style=cargo's default do_install only installs a single binary named
# ${pkgname}. This crate produces seven -- mirrors the Makefile's BINS, which
# deliberately leaves out helium-locker (see the README's Locker section for
# the upstream niri/layer-shika incompatibility that keeps it out of
# `make install` too).
do_install() {
	vbin target/x86_64-unknown-linux-gnu/release/helium-shell
	vbin target/x86_64-unknown-linux-gnu/release/helium-launcher
	vbin target/x86_64-unknown-linux-gnu/release/helium-session
	vbin target/x86_64-unknown-linux-gnu/release/helium-osd
	vbin target/x86_64-unknown-linux-gnu/release/helium-wallpaper
	vbin target/x86_64-unknown-linux-gnu/release/helium-backdrop
	vbin target/x86_64-unknown-linux-gnu/release/helium-ollama
	vinstall assets/d77-logo.svg 644 usr/share/helium-d77/
	vlicense LICENSE
	vdoc README.md
}
