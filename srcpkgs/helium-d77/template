# Template file for 'helium-d77'
pkgname=helium-d77
version=0.5.0
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="wayland-devel libxkbcommon-devel fontconfig-devel freetype-devel pam-devel"
# xbps has no optional dependencies, and unversioned ones never hold back
# upgrades. helium-osd calls amixer, brightnessctl and powerprofilesctl.
depends="pam-libs wl-clipboard alsa-utils brightnessctl power-profiles-daemon eww dgop"
short_desc="Wayland shell built with the Helium shell framework"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://github.com/dani-77/helium-d77"
distfiles="https://github.com/dani-77/helium-d77/archive/refs/tags/${version}.tar.gz"
checksum=b85abc73b8b39578058bf97c0a4f1b2e0d82282ddf07109b77a7b1e79e2feacb
repository=d77
conf_files="/etc/pam.d/helium-locker"

# build_style=cargo's default do_install only installs a binary named
# ${pkgname}. This crate builds one `helium` binary; every program is a
# helium-<applet> symlink to it, as in the Makefile.
do_install() {
	vbin target/${RUST_TARGET}/release/helium
	for applet in shell launcher session osd wallpaper backdrop ollama locker; do
		ln -s helium ${DESTDIR}/usr/bin/helium-${applet}
	done
	vinstall pam.d/helium-locker 644 etc/pam.d
	vinstall assets/d77-logo.svg 644 usr/share/helium-d77/
	vinstall monitor/d77-monitor 755 usr/share/helium-d77/monitor
	vinstall monitor/eww.yuck 644 usr/share/helium-d77/monitor
	vinstall monitor/eww.scss 644 usr/share/helium-d77/monitor
	vlicense LICENSE
	vdoc README.md
}
