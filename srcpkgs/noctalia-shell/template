hostmakedepends="just meson ninja pkg-config cmake wayland-devel"
makedepends="sdbus-c++-devel wayland-devel wayland-protocols freetype-devel
 fontconfig-devel cairo-devel pango-devel harfbuzz-devel librsvg-devel
 libxkbcommon-devel polkit-devel pipewire-devel wireplumber-devel libcurl-devel
 libqalculate-devel pam-devel libepoxy-devel libglvnd-devel libglib-devel
 libsecret-devel libsodium-devel libical-devel libjxl-devel libwebp-devel
 libxml2-devel libmd4c-devel json-c++ libsndfile-devel tomlplusplus-devel stb"
# git: plugin sources/auto-update; ddcutil: external monitor brightness;
# power-profiles-daemon: power profile control (D-Bus); upower: battery.
