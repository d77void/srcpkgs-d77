pre_configure() {
	# gdk-pixbuf >= 2.44 is only asked for its glycin-backed loaders; every
	# gdk-pixbuf API Luciole calls already exists in 2.42.
	vsed -i "s/'gdk-pixbuf-2.0', version: '>=2.44'/'gdk-pixbuf-2.0', version: '>=2.42'/" meson.build
}
