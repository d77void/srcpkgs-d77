# Template file for 'dgop'
pkgname=dgop
version=2.0.0
revision=2
archs="x86_64 x86_64-musl"
build_style=gnu-makefile
make_build_args="VERSION=${version}"
build_helper="qemu"
hostmakedepends="go"
short_desc="API & CLI for System & Process Monitoring"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://github.com/duxlabs-dev/dux-gop"
changelog="https://github.com/duxlabs-dev/dux-gop/releases/tag/v${version}"
distfiles="https://github.com/duxlabs-dev/dux-gop/archive/refs/tags/v${version}.tar.gz"
checksum=e5d2cee5b34c9be5098423b4ee5b602c0cc1503adbfe227df1d732c5d614837e
repository=d77

do_install() {
	vbin bin/dgop
	vbin bin/dgop dankgop
	vlicense LICENSE
	vdoc README.md
}
post_install() {
	for sh in bash fish zsh; do
	vtargetrun bin/dgop completion "$sh" > "dankgop.$sh"
	vcompletion "dankgop.$sh" "$sh" dankgop
	done
}
