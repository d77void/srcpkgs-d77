# Template file for 'ipscan'
pkgname=ipscan
version=3.10.0
revision=3
archs="x86_64"
hostmakedepends="openjdk25"
depends="openjdk25"
short_desc="Fast and friendly network scanner"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="GPL-2.0-only"
homepage="https://angryip.org"
distfiles="https://github.com/angryip/ipscan/archive/refs/tags/${version}.tar.gz"
checksum=2516b177a491e690ff5e456144ab0c56bbfae28d782f478657290e5e25f98847
nocross="gradle runs the host JVM"
repository=d77

# Built from the source tarball with the bundled gradle wrapper (gradle and
# the maven dependencies, SWT included, are downloaded at build time).
#
# build.gradle takes the version from `git describe`, which doesn't work in a
# release tarball, so it is pinned here. The `linux64` task is the fat jar;
# its `linux64.min` finalizer (proguard + .deb/.rpm packaging through
# dpkg-deb/rpmbuild) is skipped -- only the jar is needed.
pre_build() {
	vsed -i 's|^version = exec("git describe --tags", ".", false) ?: "unknown"|version = "'"${version}"'"|' \
		build.gradle
}

do_build() {
	export JAVA_HOME=/usr/lib/jvm/openjdk25
	export GRADLE_USER_HOME="${wrksrc}/.gradle-home"
	./gradlew --no-daemon linux64 -x linux64.min -x test
}

# Upstream's own /usr/bin/ipscan launcher locates the jar itself
# (glob "/usr/lib*/ipscan/ipscan*.jar") and needs OpenJDK 25+
# (--enable-native-access is a JDK 22+ flag; its fallback message names 25).
do_install() {
	vinstall build/libs/ipscan-${version}-linux64.jar 755 usr/lib/ipscan
	vbin ext/deb-bundle/usr/bin/ipscan
	vinstall ext/deb-bundle/usr/share/applications/net.azib.ipscan.desktop 644 usr/share/applications
	vinstall ext/deb-bundle/usr/share/metainfo/net.azib.ipscan.metainfo.xml 644 usr/share/metainfo
	vinstall resources/images/icon128.png 644 usr/share/pixmaps net.azib.ipscan.png
	vdoc README.md
}
