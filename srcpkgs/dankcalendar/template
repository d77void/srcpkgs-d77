# Template file for 'dankcalendar'
pkgname=dankcalendar
version=2.0.0
revision=1
archs="x86_64 x86_64-musl"
build_style=gnu-makefile
build_helper="qemu"
make_build_target=build
hostmakedepends="go pkg-config automake tar"
makedepends="qt6-base-devel qt6-declarative-devel qt6-svg-devel qt6-wayland-devel qt6-tools-devel"
depends="font-inter ttf-material-icons"
short_desc="Standalone calendar app that brings all your calendars together"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://danklinux.com"
changelog="https://github.com/AvengeMedia/dankcalendar/releases/tag/v${version}"
# dank-qml-common is a git submodule; GitHub tarballs don't include submodule
# content, so fetch it separately at the commit pinned by the v${version} tag
# (see: git ls-tree v${version} dank-qml-common) and unpack it into place.
_dankcommon_commit=b50afcf549f7e9c8f07c85b7f3fbba867701650d
distfiles="https://github.com/AvengeMedia/dankcalendar/archive/refs/tags/v${version}.tar.gz
 https://github.com/AvengeMedia/dank-qml-common/archive/${_dankcommon_commit}.tar.gz>dank-qml-common-${_dankcommon_commit}.tar.gz"
checksum="866ee8dfedb91639c8d13081cb52ff743eaeeb322545f67ff74f74eb85674cdb
 3346da579a6d47b9cc091fa7597d10bd0f716bfd74b1c5b0835f80cbca027d6b"
skip_extraction="dank-qml-common-${_dankcommon_commit}.tar.gz"
repository=d77

post_extract() {
	vsrcextract -C dank-qml-common "dank-qml-common-${_dankcommon_commit}.tar.gz"
}

do_install() {
	vbin core/bin/dcal

	vmkdir usr/share/quickshell/dankcal
	vcopy "quickshell/*" usr/share/quickshell/dankcal

	vdoc README.md

	vinstall assets/com.danklinux.dankcalendar.desktop 644 usr/share/applications
	vinstall assets/com.danklinux.dankcalendar.svg 644 usr/share/icons/hicolor/scalable/apps/
	vinstall assets/com.danklinux.dankcalendar.metainfo.xml 644 usr/share/metainfo
	vlicense LICENSE
}

post_install() {
	for sh in bash fish zsh; do
	vtargetrun core/bin/dcal completion "$sh" > "dcal.$sh"
	vcompletion "dcal.$sh" "$sh" dcal
	done
}
