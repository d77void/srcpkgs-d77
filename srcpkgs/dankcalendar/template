# Template file for 'dankcalendar'
pkgname=dankcalendar
version=2.1.0
revision=1
archs="x86_64 x86_64-musl"
build_style=gnu-makefile
build_helper="qemu"
make_build_args="VERSION=${version}"
make_build_target=build
hostmakedepends="go pkg-config automake tar"
makedepends="qt6-base-devel qt6-declarative-devel qt6-svg-devel qt6-wayland-devel qt6-tools-devel"
depends="font-inter ttf-material-icons"
short_desc="Standalone calendar app that brings all your calendars together"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://danklinux.com"
changelog="https://github.com/duxlabs-dev/dux-calendar/releases/tag/v${version}"
# dux-qml-common is a git submodule; GitHub tarballs don't include submodule
# content, so fetch it separately at the commit pinned by the v${version} tag
# (see: git ls-tree v${version} dux-qml-common) and unpack it into place.
_duxcommon_commit=be3e16ca62866a749b34cfefe1aaed81cfe21e94
distfiles="https://github.com/duxlabs-dev/dux-calendar/archive/refs/tags/v${version}.tar.gz
 https://github.com/duxlabs-dev/dux-qml-common/archive/${_duxcommon_commit}.tar.gz>dux-qml-common-${_duxcommon_commit}.tar.gz"
checksum="3dc36a1fdeb5420eef327e95f142d0b97038d445525e65bf01a75658eb507f18
 9659915ac72292895f148548f15e17e25149e71df9771b614f481a58513c29d5"
skip_extraction="dux-qml-common-${_duxcommon_commit}.tar.gz"
repository=d77

post_extract() {
	vsrcextract -C dux-qml-common "dux-qml-common-${_duxcommon_commit}.tar.gz"
}

do_install() {
	vbin core/bin/dcal

	vmkdir usr/share/quickshell/dankcal
	vcopy "quickshell/*" usr/share/quickshell/dankcal
	# quickshell/DCommon is a symlink into the dux-qml-common submodule,
	# which would dangle once installed; ship the real directory instead
	rm "${DESTDIR}/usr/share/quickshell/dankcal/DCommon"
	vcopy dux-qml-common/DCommon usr/share/quickshell/dankcal

	vdoc README.md

	vinstall assets/dev.duxlabs.calendar.desktop 644 usr/share/applications
	vinstall assets/dev.duxlabs.calendar.svg 644 usr/share/icons/hicolor/scalable/apps/
	vinstall assets/dev.duxlabs.calendar.metainfo.xml 644 usr/share/metainfo
	vlicense LICENSE
}

post_install() {
	for sh in bash fish zsh; do
	vtargetrun core/bin/dcal completion "$sh" > "dcal.$sh"
	vcompletion "dcal.$sh" "$sh" dcal
	done
}
