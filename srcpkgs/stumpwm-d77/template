# Template file for 'stumpwm-d77'
pkgname=stumpwm-d77
version=24.11
revision=2
hostmakedepends="autoconf sbcl"
depends="feh redshift rofi slock st xautolock xcompmgr alsa-utils"
conflicts="stumpwm"
nopie_files="/usr/bin/stumpwm"
nostrip_files="/usr/bin/stumpwm"
nodebug=yes
short_desc="StumpWM tiling window manager, Daniel Azevedo's personal build"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="GPL-2.0-or-later"
homepage="https://stumpwm.github.io/"
_contrib_commit=78b574de489fa4a4c156d15a55ac991739a9c58f
distfiles="https://github.com/stumpwm/stumpwm/archive/refs/tags/${version}.tar.gz
 http://beta.quicklisp.org/archive/alexandria/2024-10-12/alexandria-20241012-git.tgz
 http://beta.quicklisp.org/archive/cl-ppcre/2025-06-22/cl-ppcre-20250622-git.tgz
 http://beta.quicklisp.org/archive/clx/2026-01-01/clx-20260101-git.tgz
 https://github.com/stumpwm/stumpwm-contrib/archive/${_contrib_commit}.tar.gz>stumpwm-contrib-${_contrib_commit}.tar.gz"
checksum="1f2a5edf30dc8897234845514ea927478645cf8fb6b05b9ba7fe7a898720e08d
 dcdfc5bac229a952358dfe661f0860e8a02480e406d0d95dee4300cdc3d45b31
 a9d6a9ca9eb862283f6079856629c8b19254f108fcde065d61f280e7c2c6ec39
