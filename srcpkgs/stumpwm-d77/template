 418fa609305ca7873791999570ca9f7ffc6e1da43551540d1b174a9918d43313"
skip_extraction="alexandria-20241012-git.tgz cl-ppcre-20250622-git.tgz
 clx-20260101-git.tgz stumpwm-contrib-${_contrib_commit}.tar.gz"
conf_files="/etc/stumpwmrc"
nocross=yes
repository=d77

post_extract() {
	vsrcextract -C alexandria alexandria-20241012-git.tgz
	vsrcextract -C cl-ppcre cl-ppcre-20250622-git.tgz
	vsrcextract -C clx clx-20260101-git.tgz
	vsrcextract -C stumpwm-contrib stumpwm-contrib-${_contrib_commit}.tar.gz
}

do_configure() {
	export CL_SOURCE_REGISTRY="${wrksrc}//:${wrksrc}/alexandria//:${wrksrc}/cl-ppcre//:${wrksrc}/clx//"
	./autogen.sh
	./configure --prefix=/usr --with-module-dir=/usr/share/stumpwm-d77/modules
}

do_build() {
	export CL_SOURCE_REGISTRY="${wrksrc}//:${wrksrc}/alexandria//:${wrksrc}/cl-ppcre//:${wrksrc}/clx//"
	make stumpwm
}

do_install() {
	vbin stumpwm

	vmkdir usr/share/stumpwm-d77/modules/util
	vmkdir usr/share/stumpwm-d77/modules/modeline
	vcopy stumpwm-contrib/util/end-session usr/share/stumpwm-d77/modules/util
	vcopy stumpwm-contrib/util/swm-gaps usr/share/stumpwm-d77/modules/util
	vcopy stumpwm-contrib/modeline/cpu usr/share/stumpwm-d77/modules/modeline
	vcopy stumpwm-contrib/modeline/mem usr/share/stumpwm-d77/modules/modeline
	vcopy stumpwm-contrib/modeline/net usr/share/stumpwm-d77/modules/modeline
	vcopy stumpwm-contrib/modeline/wifi usr/share/stumpwm-d77/modules/modeline
	vcopy stumpwm-contrib/modeline/battery-portable usr/share/stumpwm-d77/modules/modeline

	vinstall ${FILESDIR}/stumpwmrc 644 etc
	vinstall ${FILESDIR}/stumpwm-d77.desktop 644 usr/share/xsessions

	vmkdir usr/share/examples/stumpwm-d77
	cp -r ${FILESDIR}/Wallpaper ${DESTDIR}/usr/share/examples/stumpwm-d77/
}
