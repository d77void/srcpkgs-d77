# Template file for 'fabric-d77'
# See void/README.md in the fabric-d77 repo for how to build this with xbps-src.
pkgname=fabric-d77
version=1.4.2
revision=1
depends="python3 python3-gobject python3-cairo python3-cffi python3-click
 python3-loguru python3-Pillow python3-psutil python3-rapidfuzz
 python3-requests python3-setproctitle python3-six python3-pam python3-thefuzz
 fabric gtk-session-lock alsa-utils brightnessctl matugen"
short_desc="GTK desktop shell for Wayland compositors, built on Fabric"
maintainer="Daniel Azevedo <daniazevedo77@gmail.com>"
license="MIT"
homepage="https://github.com/dani-77/fabric-d77"

distfiles="https://github.com/dani-77/fabric-d77/archive/refs/tags/${version}.tar.gz"
checksum=2dc977c7659cf4f723dbacb453a1f83a70913b0a0981a885d2aff7617994c9b4
repository=d77

do_install() {
	vmkdir usr/share/fabric-d77
	vcopy "*.py" usr/share/fabric-d77
	vcopy assets usr/share/fabric-d77
	vcopy theme usr/share/fabric-d77
	vcopy style.css usr/share/fabric-d77

	vbin ${FILESDIR}/fabric-d77
	vbin bin/fabric-d77-signal

	vinstall pam/fabric-d77 644 etc/pam.d fabric-d77

	vlicense LICENSE
}

conf_files="/etc/pam.d/fabric-d77"
