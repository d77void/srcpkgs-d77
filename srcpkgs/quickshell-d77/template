# Template file for 'quickshell-d77'
pkgname=quickshell-d77
version=1.6.2
revision=1
build_style=gnu-makefile
hostmakedepends="make rsync"
makedepends="wayland-devel"
# quickshell is required at runtime but intentionally NOT listed in depends=:
# pinning it here holds back system upgrades whenever quickshell-d77 is
# installed. Install quickshell yourself alongside this package.
# matugen (from the official Void repo) generates the wallpaper palette; xbps has no
# optional dependencies, and an unversioned one never holds back upgrades.
depends="power-profiles-daemon alsa-utils alsa-tools brightnessctl wireless_tools matugen"
short_desc="Quickshell d77 shell for wayland compositors"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://github.com/dani-77/quickshell-d77"
changelog="https://github.com/dani-77/quickshell-d77/releases"
distfiles="https://github.com/dani-77/quickshell-d77/archive/refs/tags/${version}.tar.gz"
checksum=437ce42d2654bfede96073482dc3d71c067e071eafedfd60d24aa8310069a588
repository=d77

post_install() {
	vlicense LICENSE
	vdoc README.md
}
