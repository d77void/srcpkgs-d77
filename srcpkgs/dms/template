# Template file for 'dms'
pkgname=dms
version=1.6.2
revision=1
archs="x86_64 x86_64-musl"
build_style=gnu-makefile
build_helper="qemu"
#make_dirs="/var/log/dir 0755 root root"
hostmakedepends="go pkg-config automake tar"
makedepends="accountsservice-devel"
depends="cava i2c-tools matugen qt6-multimedia power-profiles-daemon qt6ct wtype cups-pk-helper"
short_desc="Desktop shell for wayland compositors built with Quickshell & GO"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://danklinux.com"
changelog="https://github.com/AvengeMedia/DankMaterialShell/releases/tag/v${version}"
# dank-qml-common is a git submodule (quickshell/DankCommon is a symlink to
# ../dank-qml-common/DankCommon); GitHub tarballs don't include submodule
# content, so fetch it separately at the commit pinned by the v${version}
# tag (see: git ls-tree v${version} dank-qml-common) and unpack it into
# place. Same submodule/approach as srcpkgs/dankcalendar.
_dankcommon_commit=26396ce432d6c71c3f5367438f96f4a8d667e160
distfiles="https://github.com/AvengeMedia/DankMaterialShell/archive/refs/tags/v${version}.tar.gz
 https://github.com/AvengeMedia/dank-qml-common/archive/${_dankcommon_commit}.tar.gz>dank-qml-common-${_dankcommon_commit}.tar.gz"
checksum="5eff09d35d39b18f9d593f0f464e2fb5be3ddf6c92fa9eb1e99c534126c62419
 f5aa4d56a937a275c9ee504c567c36c141cb11297cae934f1b5cf3cf3620de10"
skip_extraction="dank-qml-common-${_dankcommon_commit}.tar.gz"
repository=d77

post_extract() {
	vsrcextract -C dank-qml-common "dank-qml-common-${_dankcommon_commit}.tar.gz"
}

do_install() {
	vbin core/bin/dms

	vmkdir usr/share/quickshell/dms
	vcopy "quickshell/*" usr/share/quickshell/dms

	vmkdir usr/share/doc/dms
	vcopy "docs/*" usr/share/doc/dms/

	vinstall assets/dms-open.desktop 644 usr/share/applications
	vinstall assets/danklogo.svg 644 usr/share/icons/hicolor/scalable/apps
	vlicense LICENSE
}

post_install() {
	for sh in bash fish zsh; do
	vtargetrun core/bin/dms completion "$sh" > "dms.$sh"
	vcompletion "dms.$sh" "$sh"
	done
}
