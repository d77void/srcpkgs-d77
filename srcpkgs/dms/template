# Template file for 'dms'
pkgname=dms
version=2.1.1
revision=1
archs="x86_64 x86_64-musl"
build_style=gnu-makefile
build_helper="qemu"
make_build_args="VERSION=${version}"
#make_dirs="/var/log/dir 0755 root root"
hostmakedepends="go pkg-config automake tar"
makedepends="accountsservice-devel"
depends="cava i2c-tools matugen qt6-multimedia power-profiles-daemon qt6ct wtype cups-pk-helper"
short_desc="Desktop shell for wayland compositors built with Quickshell & GO"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://duxlabs.dev"
changelog="https://github.com/duxlabs-dev/dux-shell/releases/tag/v${version}"
# dux-qml-common is a git submodule (quickshell/DCommon is a symlink to
# ../dux-qml-common/DCommon); GitHub tarballs don't include submodule
# content, so fetch it separately at the commit pinned by the v${version}
# tag (see: git ls-tree v${version} dux-qml-common) and unpack it into
# place. Same submodule/approach as srcpkgs/dankcalendar.
_duxcommon_commit=b02c0321263372a8c9d18c6648b4608a1865ff90
distfiles="https://github.com/duxlabs-dev/dux-shell/archive/refs/tags/v${version}.tar.gz
 https://github.com/duxlabs-dev/dux-qml-common/archive/${_duxcommon_commit}.tar.gz>dux-qml-common-${_duxcommon_commit}.tar.gz"
checksum="3ea414921aa2dc1b10aa53f9653c8101a69e9b393cd34882805080c8cb97a765
 d67b3ad0416ebf9ab1ac914bcb490b1e6ff98b69aa74d20da95804c7d2527af2"
skip_extraction="dux-qml-common-${_duxcommon_commit}.tar.gz"
repository=d77

post_extract() {
	vsrcextract -C dux-qml-common "dux-qml-common-${_duxcommon_commit}.tar.gz"
}

do_install() {
	vbin core/bin/dms

	vmkdir usr/share/quickshell/dms
	vcopy "quickshell/*" usr/share/quickshell/dms
	# quickshell/DCommon is a symlink into the dux-qml-common submodule,
	# which would dangle once installed; ship the real directory instead
	rm "${DESTDIR}/usr/share/quickshell/dms/DCommon"
	vcopy dux-qml-common/DCommon usr/share/quickshell/dms

	vdoc README.md

	vinstall assets/dms-open.desktop 644 usr/share/applications
	vinstall assets/danklogo.svg 644 usr/share/icons/hicolor/scalable/apps
	vlicense LICENSE
}

post_install() {
	for sh in bash fish zsh; do
	vtargetrun core/bin/dms completion "$sh" > "dms.$sh"
	vcompletion "dms.$sh" "$sh"
	done
}
