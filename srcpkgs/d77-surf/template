# Template file for 'd77-surf'
pkgname=d77-surf
version=2.1
revision=1
wrksrc="surf-${version}"
build_style="gnu-makefile"
hostmakedepends="pkg-config xdg-utils"
makedepends="libwebkit2gtk41-devel gcr-devel libxdg-basedir-devel"
depends="xprop dmenu xdg-utils"
short_desc="Simple web browser based on WebKit/GTK+"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
