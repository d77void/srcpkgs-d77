# Template file for 'utumno'
pkgname=utumno
version=0.2.0
revision=1
build_style=gnu-makefile
hostmakedepends="make rsync"
makedepends="wayland-devel"
# quickshell is required at runtime but intentionally NOT listed in depends=:
# pinning it here holds back system upgrades whenever utumno is installed.
# Install quickshell yourself alongside this package.
# matugen (from the d77 repo) generates the wallpaper palette; xbps has no
# optional dependencies, and an unversioned one never holds back upgrades.
depends="power-profiles-daemon alsa-utils alsa-tools brightnessctl wireless_tools matugen"
short_desc="Minimal Quickshell shell for wayland compositors, lighter sibling of quickshell-d77"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MIT"
homepage="https://github.com/dani-77/utumno"
changelog="https://github.com/dani-77/utumno/releases"
distfiles="https://github.com/dani-77/utumno/archive/refs/tags/${version}.tar.gz"
checksum=cae997a22c31c96bc9c1c37c857cf4757ef16c0e69d43e8761b84d9c95ff2ed6
repository=d77

post_install() {
	vlicense LICENSE
	vdoc README.md
}
