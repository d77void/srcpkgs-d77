# Template file for 'wasp'
pkgname=wasp
version=0.10.1
revision=1
build_style=gnu-makefile
# config.mk derives VERSION from `git describe`, which a release tarball
# can't answer (inside xbps-src it picks up an unrelated repo instead).
make_build_args="VERSION=${version}"
hostmakedepends="pkg-config wayland-devel wayland-protocols"
makedepends="libinput-devel wayland-devel wlroots0.20-devel
 libxkbcommon-devel libxcb-devel xcb-util-wm-devel lua54-devel
 scenefx0.5-devel fcft-devel pixman-devel tllist"
depends="xorg-server-xwayland"
conf_files="/etc/xdg-desktop-portal/wasp-portals.conf"
short_desc="Lua-configurable Wayland compositor based on dwl/wlroots"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="GPL-3.0-or-later, MIT"
homepage="https://github.com/dani-77/wasp"
changelog="https://github.com/dani-77/wasp/releases/tag/v${version}"
distfiles="https://github.com/dani-77/wasp/archive/refs/tags/v${version}.tar.gz"
checksum=2cc4b198ea93d1ca50e398891ab0eca4d9b3ce2c137b00bd9cbbc5d99163208d
repository=d77

do_install() {
	make PREFIX=/usr DESTDIR=$DESTDIR VERSION=${version} install
	vlicense LICENSE.wasp LICENSE
}
