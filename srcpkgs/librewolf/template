# Template file for 'librewolf'
#
# LibreWolf stopped publishing its prepared source tarball (Firefox with the
# LibreWolf layer already applied) after 153.0.3-1, so the tree is assembled
# here the same way LibreWolf's own `make dir` does it:
#  - Mozilla's Firefox ${version} release source (LibreWolf's Makefile fetches
#    firefox-$(version) from archive.mozilla.org/pub/firefox/releases, where
#    $(version) is the `version` file of the librewolf/source tag -- check it
#    matches on every bump);
#  - the librewolf/source repo at tag ${version}-${_lwrel} (patches, settings,
#    branding, LibreWolf's own strings), applied by its
#    scripts/librewolf-patches.py in post_extract;
#  - the full Firefox l10n, pinned to the firefox-l10n revision Firefox
#    ${version} itself lists in browser/locales/l10n-changesets.json
#    (_l10nrev), instead of the unpinned git clone the script would do.
# The build setup and the patches/ directory follow void-packages'
# srcpkgs/firefox, so keep them in sync with the firefox template of the
# same Firefox version.
#
pkgname=librewolf
version=157.0
revision=1
_lwrel=1
# browser/locales/l10n-changesets.json at FIREFOX_157_0_RELEASE
_l10nrev=1ccd8a9a31a6c858f281798805b92b609b22b55b
_llvmver=22
build_helper="rust"
hostmakedepends="unzip zip pkg-config perl python3
 yasm rust cargo llvm${_llvmver} clang${_llvmver} lld${_llvmver}
 nodejs cbindgen nasm which tar xz $(vopt_if wasi wasi-sdk)"
makedepends="nss-devel libjpeg-turbo-devel gtk+3-devel
 pixman-devel libevent-devel libnotify-devel libwebp-devel
 libXrender-devel libXcomposite-devel libSM-devel libXt-devel rust-std
 libXdamage-devel freetype-devel $(vopt_if wasi wasi-sdk)
 $(vopt_if alsa alsa-lib-devel) $(vopt_if dbus dbus-glib-devel)
 $(vopt_if pulseaudio pulseaudio-devel) $(vopt_if xscreensaver libXScrnSaver-devel)
 $(vopt_if sndio sndio-devel) $(vopt_if jack jack-devel)"
depends="nss>=3.129 nspr>=4.39 desktop-file-utils hicolor-icon-theme pciutils"
short_desc="Firefox fork focused on privacy, security and freedom"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="MPL-2.0 AND GPL-3.0-only AND LGPL-2.1-only AND LGPL-3.0-only"
homepage="https://librewolf.net"
changelog="https://codeberg.org/librewolf/source/releases"
distfiles="${MOZILLA_SITE}/firefox/releases/${version}/source/firefox-${version}.source.tar.xz
 https://codeberg.org/librewolf/source/archive/${version}-${_lwrel}.tar.gz>librewolf-source-${version}-${_lwrel}.tar.gz
 https://github.com/mozilla-l10n/firefox-l10n/archive/${_l10nrev}.tar.gz>firefox-l10n-${_l10nrev}.tar.gz"
# the two git archives are generated on the fly: checksum their contents
checksum="259c564dd4bbd56bbe8a9a6cf001fc8812853567fd3a78e77c9ddf10d7d4e982
 @d158f42a37e107e1b44ffd49ae5547a853d93ad2034e8554b3254d34204add10
 @e07f153fc4ee8c97d25f0a09a62fc7250ea5fd70f216cbf1d335930cc4011fbf"
skip_extraction="librewolf-source-${version}-${_lwrel}.tar.gz
 firefox-l10n-${_l10nrev}.tar.gz"
replaces="librewolf-bin>=0"
lib32disabled=yes
repository=d77

build_options="alsa jack dbus pulseaudio xscreensaver sndio wayland lto clang wasi"
build_options_default="alsa jack dbus pulseaudio xscreensaver sndio wayland clang wasi"

desc_option_lto="Enable Link Time Optimization"
desc_option_clang="Build with clang"
desc_option_wasi="Build wasm sandboxed libraries"

case $XBPS_TARGET_MACHINE in
	armv[56]*) broken="required NEON extensions are not supported on armv6" ;;
	ppc64*) ;;
	ppc*) broken="xptcall bitrot" ;;
esac

# we need this because cargo verifies checksums of all files in vendor
# crates when it builds and gives us no way to override or update the
# file sanely... so just clear out the file list
_clear_vendor_checksums() {
	sed -i 's/\("files":{\)[^}]*/\1/' third_party/rust/$1/.cargo-checksum.json
}

post_extract() {
	local _dist="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	local _lwsrc="${XBPS_BUILDDIR}/librewolf-source-${version}-${_lwrel}"
	local _lwtree="${_lwsrc}/librewolf-${version}-${_lwrel}"

	# Full locales first: the script appends LibreWolf's strings to them.
	mkdir -p lw/l10n
	tar -xf "${_dist}/firefox-l10n-${_l10nrev}.tar.gz" --strip-components=1 -C lw/l10n
	rm -rf lw/l10n/.github lw/l10n/LICENSE lw/l10n/README*

	# The script runs from the librewolf/source checkout and works on the
	# Firefox tree at ./librewolf-<version>-<release>, using ../patches,
	# ../assets, ../settings, ... -- so the tree has to physically sit there
	# (a symlink would resolve .. against wrksrc's real parent).
	rm -rf "${_lwsrc}"
	mkdir -p "${_lwsrc}"
	tar -xf "${_dist}/librewolf-source-${version}-${_lwrel}.tar.gz" --strip-components=1 -C "${_lwsrc}"
	cd "${XBPS_BUILDDIR}"
	mv "${wrksrc}" "${_lwtree}"
	if ! (cd "${_lwsrc}" && SKIP_FETCHING_LOCALES=1 python3 scripts/librewolf-patches.py ${version} ${_lwrel}); then
		mv "${_lwtree}" "${wrksrc}"
		msg_error "${pkgver}: scripts/librewolf-patches.py failed\n"
	fi
	mv "${_lwtree}" "${wrksrc}"
	rm -rf "${_lwsrc}"
	cd "${wrksrc}"

	case "$XBPS_TARGET_MACHINE" in
	*-musl)
		cp "${FILESDIR}/stab.h" toolkit/crashreporter/google-breakpad/src/
		;;
	esac
}

post_patch() {
	_clear_vendor_checksums audio_thread_priority
	if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
		vsed -e '\;sys/single_threaded.h;d' -i config/system-headers.mozbuild
	fi
}

do_build() {
	export AS="${CC}"
	export CFLAGS="-O2 -ftrivial-auto-var-init=zero -fwrapv"
	export CXXFLAGS="-O2 -ftrivial-auto-var-init=zero -fwrapv"
	# unset HOST_C{,XX}FLAGS since the firefox build system uses them internally and
	# if they are exported they end up in the cargo environment, where they are not
	# supposed to be.
	unset HOST_CFLAGS
	unset HOST_CXXFLAGS
	export LDFLAGS="-Wl,-rpath=/usr/lib/librewolf"

	if [ "$build_option_clang" ]; then
		export CC=clang
		export CXX=clang++
		export AS=clang
		export AR=llvm-ar
		export NM=llvm-nm
		export HOST_CC=clang
		export HOST_CXX=clang++

		export ASFLAGS="--target=${XBPS_CROSS_TRIPLET:-${XBPS_TRIPLET}}"
	fi

	# LibreWolf's mozconfig enables jemalloc and replace-malloc; musl
	# can't use jemalloc (and replace-malloc depends on it)
	jemalloc() {
		if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
			echo "ac_add_options --disable-jemalloc"
		else
			echo "ac_add_options --enable-jemalloc"
			echo "ac_add_options --enable-replace-malloc"
		fi
	}

	disable_elfhack() {
		case "$XBPS_TARGET_MACHINE" in
		x86_64*|i686*|arm*|aarch64*) echo "ac_add_options --disable-elf-hack" ;;
		esac
	}

	disable_webrtc() {
		case "$XBPS_TARGET_MACHINE" in
		armv7l*) echo "ac_add_options --disable-webrtc" ;;
		esac

		if [ "$XBPS_TARGET_ENDIAN" = "be" ]; then
			echo "ac_add_options --disable-webrtc"
		fi
	}

	disable_wasi() {
		if [ "$build_option_wasi" ]; then
			echo "ac_add_options --with-wasi-sysroot=/usr/share/wasi-sysroot"
		else
			echo "ac_add_options --without-wasm-sandboxed-libraries"
		fi
	}

	# void's firefox mozconfig + the options of LibreWolf's own mozconfig
	# (minus --enable-bootstrap: the system toolchain is used instead of
	# mozilla's prebuilt ones)
	cat <<-! >.mozconfig
	ac_add_options --prefix=/usr
	ac_add_options --libdir=/usr/lib
	ac_add_options --host=${XBPS_TRIPLET}
	ac_add_options --target=${XBPS_CROSS_TRIPLET:-${XBPS_TRIPLET}}
	ac_add_options --enable-linker=$(vopt_if clang lld bfd)
	ac_add_options --disable-bootstrap
	$(vopt_if lto 'ac_add_options --enable-lto=cross')
	$(vopt_if clang 'ac_add_options --with-libclang-path=/usr/lib')

	ac_add_options --enable-application=browser
	ac_add_options --with-app-name=librewolf
	ac_add_options --with-branding=browser/branding/librewolf
	ac_add_options --with-l10n-base=${wrksrc}/lw/l10n
	ac_add_options --enable-release
	ac_add_options --enable-hardening
	ac_add_options --enable-stl-hardening
	ac_add_options --enable-rust-simd
	ac_add_options --enable-optimize="\${CFLAGS}"
	ac_add_options --enable-path-remapping=c,rust
	ac_add_options --enable-packed-relative-relocs
	ac_add_options --disable-cargo-incremental
	ac_add_options --disable-tests
	ac_add_options --disable-crashreporter
	ac_add_options --disable-default-browser-agent
	ac_add_options --disable-updater
	ac_add_options --disable-install-strip
	ac_add_options --disable-strip
	ac_add_options --disable-profiling
	ac_add_options --disable-debug
	ac_add_options --disable-debug-symbols
	$(jemalloc)
	$(disable_elfhack)
	$(disable_webrtc)

	$(disable_wasi)

	ac_add_options --enable-system-pixman
	ac_add_options --with-system-ffi
	ac_add_options --with-system-jpeg
	ac_add_options --with-system-libevent
	ac_add_options --with-system-nspr
	ac_add_options --with-system-nss
	ac_add_options --with-system-webp
	ac_add_options --with-system-zlib
	# XXX: the system's libpng doesn't have APNG support
	ac_add_options --without-system-png

	ac_add_options --with-unsigned-addon-scopes=app,system
	ac_add_options --allow-addon-sideload

	ac_add_options $(vopt_enable dbus)
	ac_add_options $(vopt_enable dbus necko-wifi)
	ac_add_options --disable-audio-backends
	ac_add_options $(vopt_enable alsa)
	ac_add_options $(vopt_enable jack)
	ac_add_options $(vopt_enable pulseaudio)
	ac_add_options $(vopt_enable sndio)
	ac_add_options --enable-default-toolkit=$(vopt_if wayland 'cairo-gtk3-wayland' 'cairo-gtk3')

	export MOZ_REQUIRE_SIGNING=
	export MOZILLA_OFFICIAL=1

	mk_add_options MOZ_OBJDIR="${wrksrc}/obj"
	mk_add_options MOZ_CRASHREPORTER=0
	mk_add_options MOZ_DATA_REPORTING=0
	mk_add_options MOZ_SERVICES_HEALTHREPORT=0
	mk_add_options MOZ_TELEMETRY_REPORTING=0
	!

	# work around large debug symbols on 32-bit hosts
	if [ "$XBPS_WORDSIZE" = "32" ]; then
		export LDFLAGS+=" -Wl,--no-keep-memory"
	fi

	if [ "$SOURCE_DATE_EPOCH" ]; then
		export MOZ_BUILD_DATE=$(date --date "@$SOURCE_DATE_EPOCH" "+%Y%m%d%H%M%S")
	fi

	export MOZ_MAKE_FLAGS="${makejobs}"
	export MOZ_NOSPAM=1
	export MOZBUILD_STATE_PATH="${wrksrc}/mozbuild"
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=system

	rm -f old-configure
	# librewolf-patches.py installs LibreWolf's own mozconfig (with
	# --enable-bootstrap); the one generated above replaces it
	rm -f mozconfig
	export MOZCONFIG="${wrksrc}/.mozconfig"

	./mach build

	# Same as LibreWolf's own `make package`: a multi-locale build with
	# every shipped locale (from lw/l10n), packaged as a tarball in
	# obj/dist/. ja-JP-mac is the macOS-only variant of ja.
	./mach package-multi-locale --locales \
		$(grep -v '^ja-JP-mac$' browser/locales/shipped-locales)
}

do_install() {
	local _tarball

	_tarball=$(find obj/dist -maxdepth 1 -name "librewolf-*.tar.*" | head -n 1)
	[ -n "${_tarball}" ] || msg_error "librewolf package tarball not found in obj/dist\n"

	vmkdir usr/lib
	tar xf "${_tarball}" -C ${DESTDIR}/usr/lib

	vmkdir usr/bin
	ln -s /usr/lib/librewolf/librewolf ${DESTDIR}/usr/bin/librewolf

	# https://bugzilla.mozilla.org/show_bug.cgi?id=658850
	ln -sf librewolf ${DESTDIR}/usr/lib/librewolf/librewolf-bin

	vinstall "${FILESDIR}/librewolf.desktop" 644 usr/share/applications

	for i in 16 32 48 64 128; do
		vinstall browser/branding/librewolf/default${i}.png 644 \
			usr/share/icons/hicolor/${i}x${i}/apps librewolf.png
	done
}
