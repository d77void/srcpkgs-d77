# Template file for 'onlykey'
pkgname=onlykey
version=6.0.0
revision=1
archs="x86_64"
hostmakedepends="nodejs"
short_desc="OnlyKey App"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="custom:OnlyKey"
homepage="https://crp.to"
changelog="https://github.com/trustcrypto/OnlyKey-App/releases"
distfiles="https://github.com/trustcrypto/OnlyKey-App/archive/refs/tags/v${version}.tar.gz"
checksum=8508ad8a3ed6263e483ffd99fc20659f35cfaaf921001225b37a5798050f0119
noverifyrdeps="libexpat.so.1"
# NW.js bundles its own libvulkan.so.1 etc. in /opt/OnlyKey/lib
noshlibprovides=yes
nocross="npm downloads the NW.js runtime for the host"
repository=d77

# Built from the source tarball with upstream's own release script
# (scripts/release.mjs: vite build + NW.js runtime staging), which assembles
# the .deb tree and then calls `fakeroot dpkg-deb --build <tree> <deb>`.
# Stand-ins for those two on PATH just copy the assembled tree out, and that
# tree is installed as is (app + NW.js runtime in /opt/OnlyKey).

do_build() {
	export npm_config_cache="${wrksrc}/.npm-cache"
	local stub="${wrksrc}/.xbps-stub"

	mkdir -p "${stub}"
	cat > "${stub}/fakeroot" <<-'_EOF'
	#!/bin/sh
	exec "$@"
	_EOF
	cat > "${stub}/dpkg-deb" <<-_EOF
	#!/bin/sh
	# dpkg-deb -Zxz --build <tree> <deb>
	rm -rf "${wrksrc}/deb-root"
	cp -a "\$3" "${wrksrc}/deb-root"
	: > "\$4"
	_EOF
	chmod 755 "${stub}/fakeroot" "${stub}/dpkg-deb"

	npm ci --no-audit --no-fund
	PATH="${stub}:${PATH}" node scripts/release.mjs --skip-audit
}

do_install() {
	vmkdir opt
	cp -a deb-root/opt/OnlyKey ${DESTDIR}/opt/

	vinstall deb-root/usr/share/applications/OnlyKey.desktop 644 usr/share/applications
	vinstall deb-root/etc/udev/rules.d/49-onlykey.rules 644 usr/lib/udev/rules.d

	vlicense LICENSE.txt
}
