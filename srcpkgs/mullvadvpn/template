# Template file for 'mullvadvpn'
pkgname=mullvadvpn
version=2026.5
revision=2
archs="x86_64 aarch64"
build_helper="rust"
hostmakedepends="cargo git nodejs pkg-config protobuf protobuf-devel python3"
makedepends="dbus-devel libmnl-devel libnftnl-devel"
short_desc="Mullvad VPN client"
maintainer="Daniel Azevedo <daniazevedo77@posteo.net>"
license="GPL-3.0-only"
homepage="https://mullvad.net/"
distfiles="https://github.com/mullvad/mullvadvpn-app/archive/refs/tags/${version}.tar.gz"
checksum=a133345d8d61f037d247ed89ff0dce823f652a7f25dea74f13a5029aa0374d23
noverifyrdeps="libexpat.so.1"
nocross="the shell completions are generated by running the built mullvad binary"
repository=d77

# Built from the mullvadvpn-app source tarball, following upstream's
# build.sh (Linux, --optimize, unsigned): the Rust daemon/CLI binaries go
# through cargo, the GUI through npm + electron-builder. The GitHub tarball
# doesn't carry the dist-assets/binaries submodule (prebuilt static
# libmnl/libnftnl), so those are linked against the system libraries
# instead. The patch switches electron-builder's linux target from deb/rpm
# to the unpacked "dir" output, which is installed into /opt/Mullvad VPN like
# the .deb did. The npm/cargo dependencies and electron are downloaded at
# build time.
#
# mullvad-daemon/build.rs shells out to `git log` for a commit date; the
# GitHub tarball has no .git history to describe, but the call still needs
# git present to spawn (otherwise it panics on ENOENT) -- it just comes back
# empty, which is harmless here.

_bins="mullvad-daemon mullvad mullvad-setup mullvad-problem-report mullvad-exclude"

pre_build() {
	# rust-toolchain.toml only matters for rustup; xbps-src uses the system
	# cargo (which must be at least the rust-version from Cargo.toml).
	rm -f rust-toolchain.toml
}

do_build() {
	export npm_config_cache="${wrksrc}/.npm-cache"
	export ELECTRON_BUILDER_CACHE="${wrksrc}/.electron-builder-cache"
	export CSC_IDENTITY_AUTO_DISCOVERY=false

	local _target=target/${RUST_TARGET}/release bin sh

	cargo build --release --locked --target ${RUST_TARGET} \
		-p mullvad-daemon --bin mullvad-daemon \
		-p mullvad-cli --bin mullvad \
		-p mullvad-setup --bin mullvad-setup \
		-p mullvad-problem-report --bin mullvad-problem-report \
		-p mullvad-exclude --bin mullvad-exclude

	# electron-builder picks them up from dist-assets/ (extraResources)
	for bin in ${_bins}; do
		cp ${_target}/${bin} dist-assets/
	done

	mkdir -p build/shell-completions
	for sh in bash zsh fish; do
		${_target}/mullvad shell-completions ${sh} build/shell-completions/
	done

	cd desktop
	npm run ci
	cd packages/mullvad-vpn
	npm run pack:linux -- --release --host-target-triple ${RUST_TARGET}
}

do_install() {
	local _unpacked bin

	_unpacked=$(find dist -maxdepth 1 -type d -name 'linux*-unpacked' | head -n 1)
	[ -n "${_unpacked}" ] || msg_error "electron-builder output not found in dist/\n"

	vmkdir "opt/Mullvad VPN"
	cp -a ${_unpacked}/. "${DESTDIR}/opt/Mullvad VPN/"

	for bin in mullvad mullvad-daemon mullvad-exclude; do
		vbin dist-assets/${bin}
	done
	ln -s "/opt/Mullvad VPN/resources/mullvad-problem-report" \
		${DESTDIR}/usr/bin/mullvad-problem-report

	vsv mullvad

	vinstall dist-assets/linux/mullvad-daemon.service 644 usr/lib/systemd/system
	vinstall dist-assets/linux/mullvad-early-boot-blocking.service 644 usr/lib/systemd/system

	vinstall build/shell-completions/mullvad.bash 644 \
		usr/share/bash-completion/completions mullvad
	vinstall build/shell-completions/_mullvad 644 usr/share/zsh/site-functions
	vinstall build/shell-completions/mullvad.fish 644 usr/share/fish/vendor_completions.d

	vmkdir usr/share/applications
	cat > ${DESTDIR}/usr/share/applications/mullvad-vpn.desktop <<-_EOF
	[Desktop Entry]
	Name=Mullvad VPN
	Exec="/opt/Mullvad VPN/mullvad-vpn" %U
	Terminal=false
	Type=Application
	Icon=mullvad-vpn
	StartupWMClass=Mullvad VPN
	Comment=Mullvad VPN client
	Categories=Network;
	_EOF

	vinstall graphics/icon.svg 644 usr/share/icons/hicolor/scalable/apps mullvad-vpn.svg
	local size
	for size in 16 32 128 256 512; do
		vinstall graphics/macOS/icon-${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps mullvad-vpn.png
	done

	vdoc CHANGELOG.md
	vlicense LICENSE.md
}
